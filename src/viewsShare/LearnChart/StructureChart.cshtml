    function GetRequest() {
        var url = location.search; //获取url中"?"符后的字串
        var theRequest = new Object();
        if (url.indexOf("?") != -1) {
            var str = url.substr(1);
            strs = str.split("&");
            for (var i = 0; i < strs.length; i++) {
                theRequest[strs[i].split("=")[0]] = unescape(strs[i].split("=")[1]);
            }
        }
        return theRequest;
    }


    function GetRequestId_PageLoad() {
        var Request = new Object();
        Request = GetRequest();

        var strQuestionID = Request['questionID'];//题目Id
        var strStructureGraphId = Request['StructureGraphId'];//结构图谱Id
        var strSectionTypeId = Request['SectionTypeId'];//章节类型Id
        var strGameLevelId = Request['GameLevelId'];//关卡Id


        $('#hidQuestionID').val(strQuestionID);
        $('#hidStructureGraphId').val(strStructureGraphId);
        $('#hidSectionTypeId').val(strSectionTypeId);
        $('#hidGameLevelId').val(strGameLevelId);

        require(["../js/Knowledges/StructureChart.js"], function (StructureChart) {
            var objPage = new StructureChart.StructureChart();
            objPage.Page_Load();
        });


    }


