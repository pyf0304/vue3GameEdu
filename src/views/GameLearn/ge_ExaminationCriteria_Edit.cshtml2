
@page
@{
    Layout = "";
}
@section Styles{
    <link rel="stylesheet" href="../lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="../css/site.css" />
}
@section Scripts{
    <script src="../lib/jquery/dist/jquery.js"></script>
    <script src="../lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="../js/site.js" asp-append-version="true"></script>
    <script src="../lib/bootstrap/dist/js/popper.js"></script>
    <script src="../lib/require/require.js" data-main="../js/src/config"></script>
}
<script>
    //所有用户自定义的JS函数建议都放在这里


</script>
<script>

    /*
     按钮单击,用于调用Js函数中btnEdit_Click
    (AutoGCLib.WA_ViewScript_Edit_TS4Html:Gen_WApi_JS_btnEdit_Click)
    */
    function btnge_ExaminationCriteria_Edit_Click(strCommandName, strKeyId) {
        require(["../js/GameLearn/ge_ExaminationCriteria_Edit_2Ex.js"], function (ge_examinationcriteria) {
            ge_examinationcriteria.ge_ExaminationCriteria_Edit_2Ex.btnEdit_Click(strCommandName, strKeyId);
        });
    }

    /*
     显示对话框
    (AutoGCLib.WA_ViewScript_Edit_TS4Html:Gen_WApi_JS_ShowDialog)
    */
    function ShowDialog(strDialogName) {
        require(['jquery', 'bootstrap'], function ($) {
            $(strDialogName).modal('show');
        });
    }

    /*
     隐藏对话框
    (AutoGCLib.WA_ViewScript_Edit_TS4Html:Gen_WApi_JS_HideDialog)
    */
    function HideDialog(strDialogName) {
        require(['jquery', 'bootstrap'], function ($) {
            $(strDialogName).modal('hide');
        });
    }
</script>
<div id="tabLayout" class="tab_layout">
    @*-- 编辑层 --*@

    <div class="modal fade" id="divEditDialog_ge_ExaminationCriteria" tabindex="-1" role="dialog" aria-labelledby="lblDialogTitle_ge_ExaminationCriteria" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="width: 635px;">
                <div class="modal-header">
                    <h4 class="modal-title" id="lblDialogTitle_ge_ExaminationCriteria">模态框（Modal）标题</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                </div>
                <div class="modal-body">
                    <table id="tabEdit" style="width:600px" class="table table-bordered table-hover table td table-sm">
                        <tr id="trEventTypeId">
                            <td class="text-right">
                                <Label id="lblControlTypeId" name="lblControlTypeId" class="col-form-label text-right" style="width:90px;">
                                    控件
                                </Label>
                            </td>
                            <td class="text-left">
                                <select id="ddlControlTypeId" name="ddlControlTypeId" class="form-control-sm" style="width:150px;"></select>
                            </td>
                            <td class="text-right">
                                <Label id="lblEventTypeId" name="lblEventTypeId" class="col-form-label text-right" style="width:90px;">
                                    事件
                                </Label>
                            </td>
                            <td class="text-left">
                                <select id="ddlEventTypeId" name="ddlEventTypeId" class="form-control-sm" style="width:150px;"></select>
                            </td>
                        </tr>
                        <tr id="trControlId">
                            <td class="text-right">
                                <Label id="lblExaminationTypeId" name="lblExaminationTypeId" class="col-form-label text-right" style="width:90px;">
                                    检查类型
                                </Label>
                            </td>
                            <td class="text-left">
                                <select id="ddlExaminationTypeId" name="ddlExaminationTypeId" class="form-control-sm" style="width:150px;"></select>
                            </td>
                            <td class="text-right">
                                <Label id="lblControlId" name="lblControlId" class="col-form-label text-right" style="width:90px;">
                                    控件Id
                                </Label>
                            </td>
                            <td class="text-left">
                                <input id="txtControlId" name="txtControlId" class="form-control-sm" style="width:150px;" />
                            </td>
                        </tr>
                        <tr id="trControlValue">
                            <td class="text-right">
                                <Label id="lblControlClass" name="lblControlClass" class="col-form-label text-right" style="width:90px;">
                                    控件样式
                                </Label>
                            </td>
                            <td class="text-left">
                                <input id="txtControlClass" name="txtControlClass" class="form-control-sm" style="width:150px;" />
                            </td>
                            <td class="text-right">
                                <Label id="lblControlValue" name="lblControlValue" class="col-form-label text-right" style="width:90px;">
                                    控件值
                                </Label>
                            </td>
                            <td class="text-left">
                                <input id="txtControlValue" name="txtControlValue" class="form-control-sm" style="width:150px;" />
                            </td>
                        </tr>
                        <tr id="trDescribe">
                            <td class="text-right">
                                <Label id="lblDescribe" name="lblDescribe" class="col-form-label text-right" style="width:90px;">
                                    标准描述
                                </Label>
                            </td>
                            <td class="text-left" ColSpan=3>
                                <input id="txtDescribe" name="txtDescribe" class="form-control-sm" style="width:350px;" />
                            </td>
                        </tr>
                        <tr id="trUpdUser" style="display:none;">
                            <td class="text-right">
                                <Label id="lblUpdDate" name="lblUpdDate" class="col-form-label text-right" style="width:90px;">
                                    修改日期
                                </Label>
                            </td>
                            <td class="text-left">
                                <input id="txtUpdDate" name="txtUpdDate" class="form-control-sm" style="width:150px;" />
                            </td>
                            <td class="text-right">
                                <Label id="lblUpdUser" name="lblUpdUser" class="col-form-label text-right" style="width:90px;">
                                    修改人
                                </Label>
                            </td>
                            <td class="text-left">
                                <input id="txtUpdUser" name="txtUpdUser" class="form-control-sm" style="width:150px;" />
                            </td>
                        </tr>
                        <tr id="trMemo">
                            <td class="text-right">
                                <Label id="lblMemo" name="lblMemo" class="col-form-label text-right" style="width:90px;">
                                    备注
                                </Label>
                            </td>
                            <td class="text-left" ColSpan=3>
                                <input id="txtMemo" name="txtMemo" class="form-control-sm" style="width:350px;" />
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button id="btnCancel_ge_ExaminationCriteria" type="button" class="btn btn-default" data-dismiss="modal">关闭</button>
                    <button id="btnSubmit_ge_ExaminationCriteria" type="button" class="btn btn-primary" onclick="btnge_ExaminationCriteria_Edit_Click('Submit')">添加</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal -->
    </div>
</div>