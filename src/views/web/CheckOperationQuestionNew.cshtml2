        $('#QuestionSubmit').attr("disabled", "disabled");


        var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
        iframe = document.getElementById('iframeResult').contentDocument.write("<div id='Test'></div>");
    }



    function ShowHtmlcode() {
        var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
        iframe = document.getElementById('iframeResult').contentDocument.write("<div id='Test'></div>");
        //判断题目是否有自带的html代码，如果有则把它存放到js文本框，用于后期操作；
        if ($("#ContentHtmlCode").val() != "") {
            // alert($("#ContentHtmlCode").val());
            //将输入框内的数据传给iframe
            //var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
            //var obj = window.frames["iframeResult"];
            //obj.document.body.innerHTML = "<div id='Test' style='display:none;'>" + $("#ContentHtmlCode").val() + "</div>";

            // var htmlCode = "<div id='Test' style='display:none;'>" + $("#ContentHtmlCode").val() + "</div>";
            var text = document.getElementById('ContentHtmlCode').value;

            iframe = document.getElementById('iframeResult').contentDocument.write(text);
        }
    }


    //运行文本域内容按钮
    function rundata() {
        //获取输入框内的数据
        var text = document.getElementById('textareaCode').value;
        // 先清空iframe
        var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";

        //var content = document.getElementById("ContentHtmlCode");

        //  alert(text);
        if (text == "") {
            alert("请编写指定要求代码再运行！");
        }
        else {
            //判断题目是否有自带的html代码，如果有则把它存放到js文本框，用于后期操作；
            if ($("#ContentHtmlCode").val() != "") {
                //    alert($("#ContentHtmlCode").val());
                //将输入框内的数据传给iframe
                var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
                // var obj = window.frames["iframeResult"];
                //  obj.document.body.innerHTML = "<div id='Test'>" + $("#ContentHtmlCode").val() + "</div>";

                var texthtml = document.getElementById('ContentHtmlCode').value;

                iframe = document.getElementById('iframeResult').contentDocument.write(texthtml);
            }


            //将输入框内的数据传给iframe
            iframe = document.getElementById('iframeResult').contentDocument.write(text);

            //首次运行加载时候，检查提交按钮去掉置灰
            $('#Checkrundata').attr("disabled", false);

            //获取用户编辑代码和源代码 然后组合替换更新到操作代码中；
            //提供源代码 ContentHtmlCode
            var strContentHtmlCode = $("#ContentHtmlCode").val();
  
            var strNewText = "<head>" + text;
            //用户自己编写代码
            var str = strContentHtmlCode;
            var pattern = "<head>";
            var Newstr = str.replace(pattern, strNewText);
            //用户操作后的组合代码  ContentCode
            $("#ContentCode").val(Newstr);
            console.log(Newstr);




            //清空2个提示label标签；
            $("#lblmsgtext").html("");
            $("#lblmsgResult").html("");
        }



    }


