@page
@{
    //Layout = null;
    //ViewData["Title"] = "欢迎";
    Layout = "~/Pages/Shared/_Layout_Game.cshtml";
    ViewData["Title"] = "首页-游戏化教育平台";
}


@section Styles{

    <link rel="stylesheet" type="text/css" href="~/css/index/css/index.css" />
    @*<link rel="stylesheet" type="text/css" href="~/css/index/css/slider.css" />*@
    <link rel="stylesheet" href="~/lib/Xadmin/css/font.css">
    <link rel="stylesheet" href="~/lib/Xadmin/css/xadmin.css">
    <style>
        .box3 {
            padding: 3px 10px 10px 10px;
            background-color: white;
            border-left: solid 1px #dbdcde;
            border-right: solid 1px #dededf;
            border-bottom: solid 1px #dbdcde;
            border-radius: 7px 4px 4px 2px;
            margin-bottom: 5px;
        }

        .box4 {
            padding: 10px 10px 0px 10px;
            background-color: white;
            border-left: solid 1px #dbdcde;
            border-right: solid 1px #dededf;
            border-bottom: solid 1px #dbdcde;
            border-radius: 7px 4px 4px 2px;
            margin-bottom: 8px;
        }

        .row {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
            margin-right: 0px;
            margin-left: 0px;
            padding-top: 5px;
            background-color: white;
            /*border-left: solid 1px #dbdcde;
            border-right: solid 1px #dededf;*/
            /*border-bottom: solid 1px #dbdcde;*/
            border-radius: 4px 4px 4px 2px;
            line-height: 3;
        }

        .alert {
            position: relative;
            padding: 0.55rem 1.25rem;
            margin-bottom: 0.5rem;
            border: 1px solid transparent;
            border-radius: 0.25rem;
        }

        .carousel-inner img {
            width: 100%;
            height: 320px;
        }

        .slider {
            width: 100%;
            /*min-width: 1000px;*/
            height: 325px;
            position: relative;
            overflow: hidden;
            /*background: #fff;*/
            text-align: center;
        }

        #demo {
            width: 80%;
            height: 325px;
            margin: 0 auto;
            /*margin-top: 2px;*/
            /*top: 10px;*/
        }
    </style>
}



@section Scripts{
    <script src="~/lib/Xadmin/lib/layui/layui.js" charset="utf-8"></script>
    <script src="~/lib/Xadmin/js/xadmin.js" type="text/javascript"></script>
}

<script>

    window.onload = function () {
        require(["../js/Web/Index.js"], function (index) {
            //$('#indexTitle').html("游戏化教育平台");
            var objPage = new index.Index();
            objPage.Page_Load();
        });
    }

    //重新加载
    function Reload() {
        Page_Load()
    }

    //菜单通道
    function liMenu_Click(key) {
        require(["../js/Web/Index.js"], function (index) {
            var objPage = new index.Index();
            objPage.liMenu_Click(key);
        });
    }


</script>



<!-- 网页图片切换 -->
<div class="slider">
    <div id="demo" class="carousel slide" data-ride="carousel">

        <!-- 指示符 -->
        <ul class="carousel-indicators">
            <li data-target="#demo" data-slide-to="0" class="active"></li>
            <li data-target="#demo" data-slide-to="1"></li>
            <li data-target="#demo" data-slide-to="2"></li>
        </ul>

        <!-- 轮播图片 -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/css/index/img/p1.jpg">
            </div>
            <div class="carousel-item">
                <img src="~/css/index/img/p2.jpg">
            </div>
            <div class="carousel-item">
                <img src="~/css/index/img/p5.jpg">
            </div>
        </div>

        <!-- 左右切换按钮 -->
        <a class="carousel-control-prev" href="#demo" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </a>
        <a class="carousel-control-next" href="#demo" data-slide="next">
            <span class="carousel-control-next-icon"></span>
        </a>

    </div>
</div>

<!-- 网页内容信息 -->
<div class="content">
    <div class="box1">
        <div class="ExpressLane1">
            @*<div class="">*@
            <ul class="list_ul1">
                <li>
                    <a href="#" class="icon-7" onclick="liMenu_Click(1)">
                        <div class="iconLeft">
                            <i></i>
                            <label>基础知识</label>
                        </div>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>

                <li>
                    <a href="#" class="icon-1" onclick="liMenu_Click(2)">
                        <div class="iconLeft">
                            <i></i>
                            <label>知识测评</label>
                        </div>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>

                <li>
                    <a href="#" class="icon-9" onclick="liMenu_Click(3)">
                        <div class="iconLeft">
                            <i></i>
                            <label>冲关游戏</label>
                        </div>
                        <span>
                            &nbsp;&nbsp;&nbsp;&nbsp;
                        </span>
                    </a>
                </li>

                <li>
                    <a href="#" class="icon-4" onclick="liMenu_Click(4)">
                        <div class="iconLeft">
                            <i></i>
                            <label>成就激励</label>
                        </div>
                        <span>
                            &nbsp;&nbsp;&nbsp;&nbsp;
                        </span>
                    </a>
                </li>
            </ul>
        </div>

    </div>

    <div class="box2">
        <div class="ExpressLane2">
            @*<div class="">*@
            <ul class="list_ul2">

                <li>
                    <a href="#" class="icon-3" onclick="liMenu_Click(5)">
                        <i></i>
                        <label>知识图谱</label>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="icon-5" onclick="liMenu_Click(6)">
                        <i></i>
                        <label>习题集</label>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="icon-2" onclick="liMenu_Click(7)">
                        <i></i>
                        <label>作业</label>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="icon-8" onclick="liMenu_Click(8)">
                        <i></i>
                        <label>学习社区</label>
                        <span>
                            &nbsp;&nbsp;&nbsp;&nbsp;
                        </span>
                    </a>
                </li>

                <li>
                    <a href="#" class="icon-6" onclick="liMenu_Click(9)">
                        <i></i>
                        <label>系统设置</label>
                        <span>&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </a>
                </li>
            </ul>
        </div>

    </div>


</div>

