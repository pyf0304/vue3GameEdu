@page
@{
    Layout = "~/Pages/Shared/_Layout_Game.cshtml";
    ViewData["Title"] = "冲关游戏-游戏化教育平台";
}


@section Styles{

<link rel="stylesheet" type="text/css" href="~/css/index/css/index.css" />
    @*<link rel="stylesheet" type="text/css" href="~/css/index/css/slider.css" />*@
<link rel="stylesheet" href="~/lib/Xadmin/css/font.css">
<link rel="stylesheet" href="~/lib/Xadmin/css/xadmin.css">
<link rel="stylesheet" href="~/css/comment.css">
    @*<link rel="stylesheet" type="text/css" href="../css/SimpleTree.css">*@

    @*<link rel="stylesheet" type="text/css" href="~/css/bootstrap-3.3.4.css">*@
<link href="~/css/indexQuestion.css" rel="stylesheet" type="text/css">

<link rel="stylesheet" type="text/css" href="../css/SimpleTree.css">
<link rel="stylesheet" type="text/css" href="../css/public.css">

<style>
    .box1 {
        margin-bottom: 10px;
    }

    .box4 {
        padding: 10px 10px 0px 10px;
        background-color: white;
        border-left: solid 1px #dbdcde;
        border-right: solid 1px #dededf;
        border-bottom: solid 1px #dbdcde;
        border-radius: 7px 4px 4px 2px;
        margin-bottom: 8px;
    }

    .row {
        display: -ms-flexbox;
        display: flex;
        -ms-flex-wrap: wrap;
        flex-wrap: wrap;
        margin-right: 0px;
        margin-left: 0px;
        padding-top: 5px;
        background-color: white;
        border-radius: 4px 4px 4px 2px;
        line-height: 3;
    }

    .alert {
        position: relative;
        padding: 0.55rem 1.25rem;
        margin-bottom: 0.5rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .carousel-inner img {
        width: 1000px;
        height: 300px;
    }

    .slider {
        width: 100%;
        min-width: 1000px;
        height: 305px;
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    #demo {
        width: 1000px;
        height: 305px;
        margin: 0 auto;
    }

    .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
        color: red;
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
        font-weight: bold;
        font-size: 15px;
    }
    /********************************左边导航********************************/
    .leftNav {
        padding: 20px;
        width: 200px;
        height: 650px;
        overflow: hidden;
        border-right: solid 1px #dededf;
        border-bottom: solid 1px #dbdcde;
        border-top: solid 1px #dededf;
        border-left: solid 1px #dbdcde;
        /*border-radius: 7px 4px 4px 2px;*/
        border-radius: 2px; /* 四个半径值分别是左上角、右上角、右下角和左下角 */
        float: left;
        background: #fff;
        font-size: 16px;
    }
    /********************************右边内容********************************/
    .rightContent {
        /*width: 690px;*/
        width: calc(100% - 210px);
        background: #fff;
        min-height: 650px;
        border-right: solid 1px #dededf;
        border-bottom: solid 1px #dbdcde;
        border-bottom: solid 1px #dbdcde;
        border-top: solid 1px #dededf;
        border-left: solid 1px #dbdcde;
        border-radius: 7px 4px 4px 2px; /* 四个半径值分别是左上角、右上角、右下角和左下角 */
        float: right;
    }




    .divTree {
        /*margin-left: 10px;*/
        padding-top: 10px;
        width: 24%;
        font-size: 17px;
        min-height: 300px;
        overflow: hidden;
        /*overflow-y:scroll;*/
        overflow-y: auto;
        border-right: solid 1px #dededf;
        border-bottom: solid 1px #dbdcde;
        border-radius: 10px 8px 8px 4px; /* 四个半径值分别是左上角、右上角、右下角和左下角 */
        float: left;
        background: #fff;
        font-family: 'Microsoft YaHei';
    }

    .divTree3 {
        border: solid 1px #fff;
        margin: 10px;
        /*bottom: 5%;*/
        z-index: 999;
        background: whitesmoke;
    }

    .MeetingTree {
        margin-top: 10px;
        width: 100%;
        min-height: 200px;
        border-radius: 10px 8px 8px 4px; /* 四个半径值分别是左上角、右上角、右下角和左下角 */
        background-color: whitesmoke;
    }


    .breadcrumb {
        padding: 8px 15px;
        margin-bottom: 0px;
        list-style: none;
        background-color: #f5f5f5;
        border-radius: 4px;
    }

    .rightContent .content {
        overflow: hidden;
        width: 100%;
        /* height: 580px; */
        padding: 0px;
        font-size: 15px;
    }

    #divQuestionPager {
        width: 650px;
        float: right;
    }
    /*分页样式*/
    .page_list1 {
        /*position: fixed;
                    right: 200px;
                    top: 203px;*/
        z-index: 999;
        width: 100%;
        text-align: right;
        height: 50px;
        line-height: 50px;
        border-radius: 5px;
        background-color: white;
        /*border: 1px solid #ddd;*/
        padding-left: 10px;
    }

    .page_list2 {
        position: fixed;
        right: 200px;
        top: 0px;
        z-index: 999;
        width: 700px;
        height: 50px;
        line-height: 50px;
        border-radius: 5px;
        background-color: white;
        padding-left: 10px;
    }
</style>
}

@section Scripts{


<script src="~/lib/jquery-1.9.1.min.js"></script>
<script src="~/lib/bootstrap.js"></script>
<script type="text/javascript" src="~/lib/Questions.js"></script>

<script src="~/lib/Xadmin/lib/layui/layui.js" charset="utf-8"></script>
<script src="~/lib/Xadmin/js/xadmin.js" type="text/javascript"></script>
<script src="../lib/require/require.js" data-main="../js/src/config"></script>

}

<script>
        var questions;
        var itemList = ["A", "B", "C", "D", "E", "F"]
        var activeQuestion = 0; //当前操作的考题编号
        var questioned = 0; //数组考题编号
        var checkQues = []; //已做答的题的集合
             /*
      按钮单击,用于调用Js函数中btn_Click
     (AutoGCLib.WA_ViewScript_TS4Html:Gen_WApi_JS_btn_Click)
     */
    function btn_Click(strCommandName, strKeyId) {
         require(["../js/Web/PassGameEx.js"], function (index) {
            index.PassGameEx.btn_Click(strCommandName, strKeyId);
         });
    }

        window.onload = function () {

            window.onscroll = function () {
                //var topScroll = document.body.scrollTop;//滚动的距离,距离顶部的距离
                var topScroll = document.body.scrollTop || document.documentElement.scrollTop

                var bignav = document.getElementById("page_list");//获取到导航栏id
                if (topScroll > 203) {  //当滚动距离大于250px时执行下面的东西
                    //bignav.removeClass = "page_list1";
                    //bignav.addClass = "page_list2";
                    $("#page_list").removeClass();
                    $("#page_list").addClass("page_list2");

                    //bignav.style.position = 'fixed';
                    //bignav.style.top = '0';
                    //bignav.style.zIndex = '9999';
                } else {//当滚动距离小于250的时候执行下面的内容，也就是让导航栏恢复原状
                    //bignav.style.position = 'static';
                    //bignav.removeClass = "page_list2";
                    //bignav.addClass = "page_list1";
                    $("#page_list").removeClass();
                    $("#page_list").addClass("page_list1");
                }
            }

            //require(["../js/Web/Index.js"], function (index) {
            //    $('#indexTitle').html("冲关游戏");
            //    var objPage = new index.Index();
            //    objPage.Page_Load();
            //});
            //questions = QuestionJosn;
            //itemList = ["A", "B", "C", "D", "E", "F"]
            //activeQuestion = 0; //当前操作的考题编号
            //questioned = 0; //
            //checkQues = []; //已做答的题的集合
            require(["../js/Web/PassGameEx.js"], function (index) {

                $('#indexTitle').html("冲关游戏");
                var objPage = new index.PassGameEx();
                objPage.Page_Load();
                //answerCard();
                //showQuestion(0);
            });

            /*答题卡的切换*/
            $("#openCard").click(function () {
                $("#closeCard").show();
                $("#answerCard").slideDown();
                $(this).hide();
            })
            $("#closeCard").click(function () {
                $("#openCard").show();
                $("#answerCard").slideUp();
                $(this).hide();
            })

            //提交试卷
            $("#submitQuestions0").click(function () {
                //调用判断文本框类型题目答案
                getInputTextValue();

                /*alert(JSON.stringify(checkQues));*/
                // alert("已做答:" + ($(".clickQue").length) + "道题,还有" + (questions.length - ($(".clickQue").length)) + "道题未完成");

                //进行下一题操作前，把当前数据存放到数据库；
                //去掉前后双引号
                var newquestions = eval(questions)
                var question = newquestions[activeQuestion];
                var vQuestionId = question.questionID;//当前题目号；
                ////获得题目选项；
                //var checkQuesObj = checkQues[activeQuestion];
                //if (checkQuesObj != undefined) {
                //    //题目选项；
                //    var questionOptionId = checkQuesObj.answer;
                //    //如果当前题目没有答案选项，那么则不需要进行，后台数据存储操作；
                //    if (questionOptionId != "") {
                //        require(["../js/Web/PassGameEx.js"], function (index) {

                //            //提交类型事件 值为2；
                //            var markType = "2";

                //            var objPage = new index.PassGameEx();
                //            objPage.AddOrUpdUserAnswerResult(vQuestionId, questionOptionId, markType);
                //        });

                //    }
                //}

                $("#hidArrayAnswer").val(JSON.stringify(checkQues));
                //数组要大于0
                if (checkQues.length > 0) {
                    require(["../js/Web/PassGameEx.js"], function (index) {
                        //提交类型事件 值为2；
                        var markType = "2";

                        var objPage = new index.PassGameEx();
                        objPage.AddOrUpdUserAnswerResult(vQuestionId, markType);
                    });
                }
                else {
                    alert("请作答再提交");
                }
            })
            ////进入下一题
            //$("#nextQuestion").click(function () {
            //    if ((activeQuestion + 1) != questions.length) showQuestion(activeQuestion + 1);
            //    showQuestion(activeQuestion)
            //})
            //进入下一题
            $("#nextQuestion0").click(function () {

                //调用判断文本框类型题目答案
                getInputTextValue();


                //进行下一题操作前，把当前数据存放到数据库；
                //去掉前后双引号
                questions = eval(questions)
                var question = questions[activeQuestion];
                var vQuestionId = question.questionID;//当前题目号；
                var vType = question.questionTypeId;//题目类型；
                ////获得题目选项；
                //var checkQuesObj = checkQues[activeQuestion];
                //if (checkQuesObj != undefined) {
                //    //题目选项；
                //    var questionOptionId = checkQuesObj.answer;
                //    //如果当前题目没有答案选项，那么则不需要进行，后台数据存储操作；
                //    if (questionOptionId != "") {
                //        require(["../js/Web/PassGameEx.js"], function (index) {
                //            //获取题目号；已经提交答案选项号；
                //            var markType = "1";

                //            var objPage = new index.PassGameEx();
                //            objPage.AddOrUpdUserAnswerResult(vQuestionId, questionOptionId, markType);
                //        });

                //    }
                //}
                $("#hidArrayAnswer").val(JSON.stringify(checkQues));


                //if ($("#hidArrayAnswer").val().length > 0) {
                if (checkQues.length > 0) {
                    require(["../js/Web/PassGameEx.js"], function (index) {

                        //下一题 值为1；
                        var markType = "1";

                        var objPage = new index.PassGameEx();
                        objPage.AddOrUpdUserAnswerResult(vQuestionId, markType,vType);
                    });
                }



                //当前操作的题号
                if ((activeQuestion + 1) != eval(questions).length) {
                    showQuestion(activeQuestion + 1, questions);
                }
                else {
                    alert("已经是最后一题");
                    //showQuestion(activeQuestion, questions)
                }
                //去掉填空题文本框样式
                $(".question_infos input[type='text']").removeClass("clickTrim");
            })

            //进入上一题
            $("#UpQuestion0").click(function () {
                //调用判断文本框类型题目答案
                getInputTextValue();
                //进行下一题操作前，把当前数据存放到数据库；
                //去掉前后双引号
                questions = eval(questions)
                var question = questions[activeQuestion];
                var vQuestionId = question.questionID;//当前题目号；
                var vType = question.questionTypeId;//题目类型；

                $("#hidArrayAnswer").val(JSON.stringify(checkQues));
                //if ($("#hidArrayAnswer").val().length > 0) {
                if (checkQues.length > 0) {
                    require(["../js/Web/PassGameEx.js"], function (index) {
                        //上一题 值为1；
                        var markType = "1";

                        var objPage = new index.PassGameEx();
                        objPage.AddOrUpdUserAnswerResult(vQuestionId, markType, vType);
                    });
                }

                //当前操作题号，如果为0，则提示
                if (activeQuestion == 0) {
                    alert("已经是第一题");
                }
                else {
                    showQuestion(activeQuestion - 1, questions);
                }
                //去掉填空题文本框样式
                $(".question_infos input[type='text']").removeClass("clickTrim");
            })

        }
        function ShowGameHistory()
        {
            $("#navTitle").html("冲关历史");
            xadmin.open('冲关历史题目', '../Web/QuestionnaireHistory')
        }
        //菜单事件
        function Menu_Click(key) {
            switch (key) {
                case 1:
                    $("#navTitle").html("游戏");
                    require(["../js/Web/PassGameEx.js"], function (index) {

                        var objPage = new index.PassGameEx();
                        objPage.GameChallenge();
                        //answerCard();
                        //showQuestion(0);
                    });
                    break;
                case 2:
                    $("#navTitle").html("得分");
                    require(["../js/Web/PassGameEx.js"], function (questionnaire) {
                        var objPage = new questionnaire.PassGameEx();
                        objPage.Getge_UserCredits();
                    });
                    break;
                case 3:
                    $("#navTitle").html("排名");
                    require(["../js/Web/PassGameEx.js"], function (questionnaire) {
                        var objPage = new questionnaire.PassGameEx();
                        objPage.Getge_UserCreditsOrderByUser();
                    });
                    break;
                case 4:
                    $("#navTitle").html("习题集");

                    require(["../js/Web/QuestionList.js"], function (questionnaire) {
                        var objPage = new questionnaire.QuestionList();
                        objPage.Page_Load();
                    });
                    //xadmin.open('知识结构图题目', '../Web/StructureChartQuestion');
                    break;
                case 5:
                    $("#navTitle").html("推荐习题");
                    // window.location.href = "../Web/CheckOperationQuestion";
                    window.location.href = '../Web/CheckOperationQuestionNew';
                    break;
                case 6:
                    $("#navTitle").html("知识点掌握");
                    require(["../js/Web/PassGameEx.js"], function (index) {

                        var objPage = new index.PassGameEx();
                        objPage.UserMaterMsg(key);
                    });
                    break;
                case 7:
                    $("#navTitle").html("冲关历史");

                    xadmin.open('冲关历史题目', '../Web/QuestionnaireHistory')
                    break;

            }


            // MenuShow(key);
        }

        //知识点掌握逻辑图
        function KnowledgeMasterChart_Click() {
            xadmin.open('知识点掌握逻辑图', '../Web/KnowledgeMasterChart');
        }

        //习题集查询事件
        function btnQuestionQuery() {
            require(["../js/Web/QuestionList.js"], function (questionnaire) {
                var objPage = new questionnaire.QuestionList();
                objPage.btnQuery_Click();
            });
        }

        function btnQuery() {

            require(["../js/Web/PassGameEx.js"], function (index) {

                var objPage = new index.PassGameEx();
                objPage.btnQuery_Click();
            });
        }


        /*
    显示对话框
    (AutoGCLib.WA_ViewScript_TS4CSharp:Gen_WApi_JS_ShowDialog)
    */
        function ShowDialogSelectionDifficulty() {
            require(['jquery', 'bootstrap'], function ($) {
                $('#editSelectionDifficulty').modal('show');
            });
        }

        /*
    隐藏对话框
    (AutoGCLib.WA_ViewScript_TS4CSharp:Gen_WApi_JS_HideDialog)
    */
        function HideDialogSelectionDifficulty() {
            require(['jquery', 'bootstrap'], function ($) {
                $('#editSelectionDifficulty').modal('hide');
            });
        }

        /*i
    获取每个关卡前几名函数
    */

        function btnChallengeClick(k) {
            require(["../js/Web/PassGameEx.js"], function (index) {

                var objPage = new index.PassGameEx();
                objPage.Getge_UserCreditsRank(k);
            });
        }

        //点击闯关事件
        function ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strGameLevelId, strLevelModeTypeId, strGameLevelName, strQuestionNum, strChallengeMode, strExamBatchNo) {

            //把查看、继续做题、重新闯关参数，存入
            $("#hidIsHistory").val(strChallengeMode);
            //$("#hidExamBatchNo").val(strExamBatchNo);

            if (strQuestionNum == 0) {
                alert("请为关卡设置题目数");
            }
            else {
                switch (strQuestionTypeId) {

                    case "02":
                        //单选题
                        $("#divQuestionShow").show();
                        $("#ulGameLevelLst").hide();
                        $("#divCaozuoQuestionList").hide();
                        require(["../js/Web/PassGameEx.js"], function (index) {

                            var objPage = new index.PassGameEx();
                            objPage.ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum, strGameLevelId, strChallengeMode, strExamBatchNo);
                        });

                        break;
                    case "01":
                        //填空题
                        $("#divQuestionShow").show();
                        $("#ulGameLevelLst").hide();
                        $("#divCaozuoQuestionList").hide();
                        require(["../js/Web/PassGameEx.js"], function (index) {

                            var objPage = new index.PassGameEx();
                            objPage.ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum, strGameLevelId, strChallengeMode, strExamBatchNo);
                        });

                        break;
                     case "10":
                        //简答题
                        $("#divQuestionShow").show();
                        $("#ulGameLevelLst").hide();
                        $("#divCaozuoQuestionList").hide();
                        require(["../js/Web/PassGameEx.js"], function (index) {

                            var objPage = new index.PassGameEx();
                            objPage.ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum, strGameLevelId, strChallengeMode, strExamBatchNo);
                        });

                        break;
                    case "11":
                        //判断题
                        $("#divQuestionShow").show();
                        $("#ulGameLevelLst").hide();
                        $("#divCaozuoQuestionList").hide();
                        require(["../js/Web/PassGameEx.js"], function (index) {

                            var objPage = new index.PassGameEx();
                            objPage.ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum, strGameLevelId, strChallengeMode, strExamBatchNo);
                        });

                        break;


                    case "03":
                        //多选题
                        $("#divQuestionShow").show();
                        $("#ulGameLevelLst").hide();
                        $("#divCaozuoQuestionList").hide();
                        require(["../js/Web/PassGameEx.js"], function (index) {

                            var objPage = new index.PassGameEx();
                            objPage.ChallengeQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum, strGameLevelId, strChallengeMode, strExamBatchNo);
                        });
                        break;

                    case "17":
                        //连连看多选题
                        xadmin.open('连连看多选题', '../Web/StructureChartQuestion?strDifficultyLevelId=' + strDifficultyLevelId + '&strQuestionTypeId=' + strQuestionTypeId + '&strGameLevelId=' + strGameLevelId + '&strLevelModeTypeId=' + strLevelModeTypeId + '&strGameLevelName=' + strGameLevelName + '&strQuestionNum=' + strQuestionNum + '');

                        break;
                    case "09":
                        //操作题
                        $("#ulGameLevelLst").hide();
                        $("#divQuestionShow").hide();
                        $("#divCaozuoQuestionList").show();

                        //require(["../js/Web/PassGameEx.js"], function (index) {

                        //    var objPage = new index.PassGameEx();
                        //    objPage.CaozuoQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum);
                        //});
                        //if (strChallengeMode == "01") {
                        //    //查看上一次
                        //    window.location.href = '../Web/OperationQuestionHistory?strGameLevelId=' + strGameLevelId + '&strExamBatchNo=' + strExamBatchNo + '';
                        //}
                        //else {
                        //    window.location.href = '../Web/CheckOperationQuestionNew?strGameLevelId=' + strGameLevelId + '';
                        //}
                        if (strChallengeMode == "01") {
                            //查看上一次
                            window.location.href = '../Web/OperationQuestionHistory?strGameLevelId=' + strGameLevelId + '&strChallengeMode=1&strExamBatchNo=' + strExamBatchNo + '';
                        }
                        else if (strChallengeMode == "02") {
                            window.location.href = '../Web/CheckOperationQuestionNew?strGameLevelId=' + strGameLevelId + '';
                        }
                        else {
                            //继续闯关3
                            window.location.href = '../Web/OperationQuestionHistory?strGameLevelId=' + strGameLevelId + '&strChallengeMode=3&strExamBatchNo=' + strExamBatchNo + '';
                        }
                        break;
                    case "16":
                        //算法
                        $("#ulGameLevelLst").hide();
                        $("#divQuestionShow").hide();
                        $("#divCaozuoQuestionList").show();

                        //require(["../js/Web/PassGameEx.js"], function (index) {

                        //    var objPage = new index.PassGameEx();
                        //    objPage.CaozuoQuestionClick(strUserId, strid_CurrEducls, strDifficultyLevelId, strQuestionTypeId, strQuestionNum);
                        //});

                        if (strChallengeMode == "01") {
                            //查看上一次
                            window.location.href = '../Web/OperationQuestionHistory?strGameLevelId=' + strGameLevelId + '&strChallengeMode=1&strExamBatchNo=' + strExamBatchNo + '';
                        }
                        else if (strChallengeMode == "02") {
                            window.location.href = '../Web/CheckOperationQuestionNew?strGameLevelId=' + strGameLevelId + '';
                        }
                        else {
                            //继续闯关3
                            window.location.href = '../Web/OperationQuestionHistory?strGameLevelId=' + strGameLevelId + '&strChallengeMode=3&strExamBatchNo=' + strExamBatchNo + '';
                        }


                        break;


                    case "14":
                        //操作题
                        xadmin.open('知识结构图题目', '../Web/StructureChartQuestion?strDifficultyLevelId=' + strDifficultyLevelId + '&strQuestionTypeId=' + strQuestionTypeId + '&strGameLevelId=' + strGameLevelId + '&strLevelModeTypeId=' + strLevelModeTypeId + '&strGameLevelName=' + strGameLevelName + '&strQuestionNum=' + strQuestionNum + '');

                        break;
                    case "15":
                        //操作题
