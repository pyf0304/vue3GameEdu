        //if ($("#hidArrayAnswer").val().length > 0) {

        //    require(["../js/Web/PassGameEx.js"], function (index) {

        //        获取题目号；已经提交答案选项号；
        //        var markType = "1";

        //        var objPage = new index.PassGameEx();
        //        objPage.AddOrUpdUserAnswerResult(vQuestionId, markType,vType);
        //    });
        //}

        //显示题目
        showQuestion(clickId, questions);
        ////查看上次 或继续做题；根据信息把做题答案展示；
        //require(["../js/Web/PassGameEx.js"], function (index) {

