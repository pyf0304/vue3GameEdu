    /*保存考题状态 已做答的状态*/
    function saveQuestionState(clickId) {

        //调用判断文本框类型题目答案
        getInputTextValue();

        //进行下一题操作前，把当前数据存放到数据库；
        //去掉前后双引号
        var newquestions = eval(questions)
        var question = newquestions[activeQuestion];
        var vQuestionId = question.questionID;//当前题目号；
        var vType = question.questionTypeId;//题目类型；
        ////获得题目选项；
        //var checkQuesObj = checkQues[activeQuestion];
