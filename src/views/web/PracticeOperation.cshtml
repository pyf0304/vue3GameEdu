@page
@{
    Layout = "~/Pages/Shared/_Layout_Game.cshtml";
    ViewData["Title"] = "实践操作-游戏化教育平台";
}


@section Styles{

    <link rel="stylesheet" type="text/css" href="~/css/index/css/index.css" />
    @*<link rel="stylesheet" type="text/css" href="~/css/index/css/slider.css" />*@
    <link rel="stylesheet" href="~/lib/Xadmin/css/font.css">
    <link rel="stylesheet" href="~/lib/Xadmin/css/xadmin.css">
    <link rel="stylesheet" href="~/css/comment.css">
    <style>
        .box1 {
            padding: 3px 10px 10px 10px;
            background-color: white;
            border-left: solid 1px #dbdcde;
            border-right: solid 1px #dededf;
            border-bottom: solid 1px #dbdcde;
            border-radius: 7px 4px 4px 2px;
            margin-bottom: 10px;
            background-color: white;
        }

        .alert {
            position: relative;
            padding: 0.55rem 1.25rem;
            margin-bottom: 0.5rem;
            border: 1px solid transparent;
            border-radius: 0.25rem;
        }

        .carousel-inner img {
            width: 1000px;
            height: 300px;
        }

        .slider {
            width: 100%;
            min-width: 1000px;
            height: 305px;
            position: relative;
            overflow: hidden;
            /*background: #fff;*/
            text-align: center;
        }

        #demo {
            width: 1000px;
            height: 305px;
            margin: 0 auto;
            /*margin-top: 2px;*/
            /*top: 10px;*/
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            color: red;
            background-color: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
            font-weight: bold;
            font-size: 15px;
        }
    </style>
}



@section Scripts{

    <script src="~/lib/Xadmin/lib/layui/layui.js" charset="utf-8"></script>
    <script src="~/lib/Xadmin/js/xadmin.js" type="text/javascript"></script>


}

<script>

    window.onload = function () {

        var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
        iframe = document.getElementById('iframeResult').contentDocument.write("<div id='Test'>test</div>");

        require(["../js/Web/Index.js"], function (index) {
            $('#indexTitle').html("实践操作");
            var objPage = new index.Index();
            objPage.Page_Load();
        });


    }

    function rundata() {
        //获取输入框内的数据
        var text = document.getElementById('textareaCode').value;
        // 先清空iframe
        var iframe = document.getElementById("iframeResult").contentWindow.document.body.innerText = "";
        //var iframe = null;
        //if (document.getElementById("iframe1").contentWindow.document.body.innerText == "") {
        //    var obj = window.frames["iframe1"];
        //    obj.document.body.innerHTML = "<div id='Test'>test</div>";
        //}
        //else {
        //    iframe = document.getElementById("iframe1").contentWindow.document.body.innerText = "";
        //    var obj = window.frames["iframe1"];
        //    obj.document.body.innerHTML = "<div id='Test'>test</div>";
        //}

        //将输入框内的数据传给iframe
        iframe = document.getElementById('iframeResult').contentDocument.write(text);
    }

    function Inspect_Click() {

        $("#iframeResult").contents().find("#txtNum1").val(5);
        $("#iframeResult").contents().find("#txtNum2").val(3);

        $("#iframeResult").contents().find("#ddlOp").val("02");

        $("#iframeResult").contents().find("#lblResult").val("");

        $("#iframeResult")[0].contentWindow.Calc();

        var NewlblResult = $("#iframeResult").contents().find("#lblResult").html();

        if (NewlblResult == "2") {
            message.success( "正确");
        } else {
            layui_Alert(3, "错误");
        }
    }

    //信息提示
    function layui_Alert(iconKey, strMsg) {

        layer.msg(strMsg, {
            icon: iconKey,
            time: 1000
        });
    }
</script>

<!-- 网页内容信息 -->
<div class="content">
    <div class="box1">
        <div class="title">
            <nav class="breadcrumb">
                <a class="breadcrumb-item" href="Index">首页</a>
                <a class="breadcrumb-item" href="Basicknowledge">基础知识</a>
                <a class="breadcrumb-item" href="#">章节课件</a>
                <span id="navTitle" class="breadcrumb-item active">实践操作</span>
            </nav>
        </div>
        <div class="alert alert-success">
            <strong>题目：</strong> 题目内容。
        </div>
        <div style="width:100%;">
            <div style="width:50%;float:left;">
                <div class="panel panel-default">
                    <div class="panel-heading">

                        <div class="row">
                            <div class="col-xs-6">
                                <button type="button" onclick="resetCode()" class="btn btn-default">源代码 <small></small>：</button>
                            </div>
                            <div class="col-xs-6 text-right">
                                <button type="button" class="btn btn-success" id="submitBTN" onclick="rundata()">
                                    点击运行
                                </button>
                            </div>
                        </div>

                    </div>
                    <div class="panel-body" style="height:665px;">
                        @*<textarea class="form-control" id="textareaCode" name="textareaCode" style="display: none; width:100%;height:665px;"></textarea>*@
                        <textarea id="textareaCode" name="textareaCode" placeholder="编辑代码" class="layui-input" style="width:100%; height:665px;"></textarea>
                    </div>
                </div>
            </div>

            <div style="width:50%;float:right;">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <form class="form-inline">
                            <button type="button" class="btn btn-default">运行结果</button>
                            <button type="button" class="btn btn-default" onclick="Inspect_Click()">检查</button>
                        </form>
                    </div>
                    <div class="panel-body">
                        <div id="iframewrapper">
                            <iframe frameborder="0" id="iframeResult" style="height: 665px;width:100%;"></iframe>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>


</div>

