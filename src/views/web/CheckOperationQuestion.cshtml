        //    var obj = window.frames["iframe1"];
        //    obj.document.body.innerHTML = "<div id='Test'>test</div>";
        //}


        //判断题目是否有自带的html代码，如果有则把它存放到js文本框，用于后期操作；
        if ($("#htmlcode").val() != "") {
