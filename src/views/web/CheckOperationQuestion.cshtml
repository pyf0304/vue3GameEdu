<script>

    function GetRequest() {
        var url = location.search; //获取url中"?"符后的字串
        var theRequest = new Object();
        if (url.indexOf("?") != -1) {
            var str = url.substr(1);
            strs = str.split("&");
            for (var i = 0; i < strs.length; i++) {
                theRequest[strs[i].split("=")[0]] = unescape(strs[i].split("=")[1]);
            }
        }
        return theRequest;
    }
    function GetQuestionID() {
        var Request = new Object();
        Request = GetRequest();
        var strQuestionId = Request['questionID'];
        //传递的问题Id
        $('#hidQuestionID').val(strQuestionId);


    }


    window.onload = function () {

        //传递临时ID；
        GetQuestionID();
        require(["../js/Web/CheckOperationQuestion.js"], function (index) {

            var objPage = new index.CheckOperationQuestion();
            objPage.Page_Load();

        });

        var iframe = document.getElementById("iframe1").contentWindow.document.body.innerText = "";
        iframe = document.getElementById('iframe1').contentDocument.write("<div id='Test'></div>");
    }

