<script type="text/javascript">

    //得到子iframe框架控件属性值；
    function Checkrundata() {

      


        //判断如果获取的指定控件下的值长度小于o说明没有作答；
        if ($("#iframe1").contents().find("input").length < 0) {
            alert("请先点击运行窗口按钮");
        }
        else {
            //判断隐藏
            var ControlId = $("#hidControlID").val();//此ID是数据库中需要操作的标准ID

            var strid = $("#iframe1").contents().find("#TestText").attr("id");
            var strclass = $("#iframe1").contents().find("#TestText").attr("class");
            var strvalue = $("#iframe1").contents().find("#TestText").val();

            //根据检查类型来判断 是隐藏还是删除；0002隐藏 0003删除；
            var ExaminationTypeId = $("#hidExaminationTypeId").val();
            var strResultType;
            if (ExaminationTypeId == "0002") {
             

                //获取iframe中的控件属性；
                //var strid = $("#iframe1").contents().find("#" + ControlId).attr("id");
             //   var strid = $("#iframe1").contents().find("#" + ControlId).attr("id");
                //if (document.getElementById("" + ControlId).style.display == "none") {
                if ($("#iframe1").contents().find("#" + ControlId).is(":hidden")) {
                    strResultType = "1";
                }
                else {
                    strResultType = "2";
                }
            }
            else {
                //判断删除；0003


            }

            require(["../js/Web/CheckOperationQuestion.js"], function (index) {

                var objPage = new index.CheckOperationQuestion();
                objPage.CheckAttributeSubmitClick(strid, strclass, strvalue,strResultType);
            });
        }

       // alert(strid + strclass + strvalue);
    }


    //父窗口调用子iframe界面js函数结果；
            function GetData(data)
            {
                document.getElementById("newid").value = data;
            }


</script>
