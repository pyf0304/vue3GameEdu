                var iframe = document.getElementById("iframe1").contentWindow.document.body.innerText = "";
                var obj = window.frames["iframe1"];
                obj.document.body.innerHTML = "<div id='Test' style='display:none;'>"+$("#htmlcode").val()+"</div>";
           
