        //var Id = $("input").attr("id");
        var Id = $("#div2").find("input").attr("id");

        //获取样式
        var Css = $("#div2").find("input").attr("class");
        //获取value
        var Value = $("#div2").find("input").attr("value");



        //$("#ii")[0].contentWindow.$("#dd").val();
