<!-- 创建节点11.3.2 -->
@*<!doctype html>
    <html class="x-admin-sm">
    <head>
        <title>插入节点</title>
        <meta charset="UTF-8">
        <meta name="renderer" content="webkit|ie-comp|ie-stand">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta http-equiv="Cache-Control" content="no-siteapp" />
        <script>
            function crNode(str)
            {
                var newP = document.createElement("label");
                newP.id = 'childId';
                var newTxt = document.createTextNode(str);
                newP.appendChild(newTxt);
                return newP;
            }
            function insetNode(nodeId,str) {
                var node = document.getElementById(nodeId);
                var newnode = crNode(str);
                if (node.parentNode)
                {
                    node.parentNode.insertBefore(newnode,node);
                }
            }

        </script>
    </head>
        <body>

           <h2 id="h">在上面插入节点</h2>
           <form id="frm" name="frm">
               输入文本:<input type="text" name="txt"/>
                    <input type="button" value="前插入" onclick="insetNode('h', document.frm.txt.value);" />

    </form>
        </body>
    </html>*@



<!-- 复制节点11.3.3 -->
@*<!doctype html>
    <html class="x-admin-sm">
    <head>
        <title>复制节点</title>
        <meta charset="UTF-8">
        <meta name="renderer" content="webkit|ie-comp|ie-stand">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta http-equiv="Cache-Control" content="no-siteapp" />
        <script>
                function AddRow(bl) {
                    var node = document.getElementById("sexType");
                    var newSelect = node.cloneNode(bl);
                    newSelect.id = 'SelectId';
                    var b = document.createElement("br");
                    di.appendChild(newSelect);
                    di.appendChild(b);

                }

        </script>
    </head>
    <body>

        <hr>
        <select name="sexType" id="sexType">
            <option value="%">请选择性别</option>
            <option value="0">男</option>
            <option value="1">女</option>
        </select>
        <hr>
        <div id="di"></div>
        <input type="button" value="复制" onclick="AddRow(false)">
        <input type="button" value="深度复制" onclick="AddRow(true)">
    </body>
    </html>*@

<!-- 删除节点11.3.3 -->
@*<!doctype html>
    <html class="x-admin-sm">
    <head>
        <title>删除节点</title>
        <meta charset="UTF-8">
        <meta name="renderer" content="webkit|ie-comp|ie-stand">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta http-equiv="Cache-Control" content="no-siteapp" />
        <script>
            function delNode() {
                    var deleten = document.getElementById("di");
                    if (deleten.hasChildNodes())
                    {
                        var trheeId = document.getElementById("three");
                        deleten.removeChild(trheeId);
                    }

                }

        </script>
    </head>
    <body>
        <h1>根据要求删除指定ID节点</h1>
        <div id="di">
            <label id="one">第一行文本</label><br />
            <label id="two">第二行文本</label><br />
            <label id="three">第三行文本</label>
        </div>
        <input type="button" value="点击删除" onclick="delNode();">
    </body>
    </html>*@

