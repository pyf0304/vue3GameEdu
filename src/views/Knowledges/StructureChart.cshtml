    //添加节点到接口
    function SectionAddNode_Click(strKeyId, strKeyName) {
        var selected_node = _jm.get_selected_node(); // as parent of new node
        if (!selected_node) {
            layui_Alert(3, "请选中父节点！")
            prompt_info('please select a node first.');
            return;
        }
        var strParentId = selected_node.id;

        require(["../js/Knowledges/StructureChart.js"], function (structureChart) {
            var objPage = new structureChart.StructureChart();
            objPage.AddStructureChart(strParentId, strKeyId, strKeyName);
            $('#' + strKeyId).remove();
        });

    }



    //添加节点
    function add_node(strKeyId, strKeyName) {
        var selected_node = _jm.get_selected_node(); // as parent of new node
        if (!selected_node) {

            prompt_info('please select a node first.');
            return;
        }
        var nodeid = strKeyId;
        var topic = strKeyName;
        var node = _jm.add_node(selected_node, nodeid, topic);
        message.success( "添加节点成功！")
        //console.log(node);
    }

    //删除节点
    function remove_node_StructureChart() {
        var selected_id = get_selected_nodeid();
        if (!selected_id) {
            layui_Alert(3, "请选中需要删除的节点！")
            prompt_info('please select a node first.');
            return;
        }

        require(["../js/Knowledges/StructureChart.js"], function (structureChart) {
            var objPage = new structureChart.StructureChart();
            objPage.StructureChart_DelRecord(selected_id);
        });
    }
    //删除节点
    function remove_node() {
        var selected_id = get_selected_nodeid();
        if (!selected_id) { prompt_info('please select a node first.'); return; }

        _jm.remove_node(selected_id);
        message.success( "删除节点成功！")
        //console.log(selected_id);
    }

    //保存结构图
    function save_node() {
        //var mind_data = _jm.get_data();
        //var mind_string = jsMind.util.json.json2string(mind_data);
        //prompt_info(mind_string);
        var mind_data = _jm.get_data('node_array');
        var mind_string = jsMind.util.json.json2string(mind_data);
        console.log(mind_string);
        //prompt_info(mind_string);
    }


    //信息提示
    function layui_Alert(iconKey, strMsg) {

        layer.msg(strMsg, {
            icon: iconKey,
            time: 1000
        });
    }

    function btn_Click(strCommandName, strKeyId) {
        require(["../js/Knowledges/StructureChart.js"], function (structureChart) {
            structureChart.StructureChart.btn_Click(strCommandName, strKeyId);
        });
    }

    //点击图列表显示图谱详情
    function GraphMenu_Click(strKey, strName, strSectionTypeId) {

        $("#hidStructureGraphId").val(strKey);
        $("#hidSectionTypeId").val(strSectionTypeId);

        //$("#navGraphName").html(strName);
        //先清除背景色
        //$("#ulGraph li a").removeClass("active");
        ////添加背景色
        //strKey = "Graph" + strKey;
        //$("#" + strKey).addClass("active");
        //让图谱面板清空
        require(["../js/Knowledges/StructureChart.js"], function (structureChart) {
            var objPage = new structureChart.StructureChart();
            objPage.BindGv_ge_StructureChartNode();
        });
    }

    //绑定结构章节
    function li_ge_StructureSection_Click() {
        require(["../js/Knowledges/StructureChart.js"], function (structureChart) {
            var objPage = new structureChart.StructureChart();
            objPage.BindGv_ge_StructureSection();
        });
    }

