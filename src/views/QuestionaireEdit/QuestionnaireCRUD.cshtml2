            </li>

            <li class="nav-item ml-3">
                     <select id="ddlQuestionTypeId" name="ddlQuestionTypeId" class="form-control" style="width:150px;"></select>
            </li>


            <li class="nav-item ml-3">
                <button id="btnImportData" name="btnImportData" class="btn btn-outline-warning btn-sm text-nowrap" onclick="btn_Click('ImportData')">导入数据</button>
            </li>

            <li class="nav-item ml-3">
                <button id="btnCloseExcelDiv" name="btnCloseExcelDiv" class="btn btn-outline-warning btn-sm text-nowrap" onclick="btn_Click('CloseExcelDiv')">关闭</button>
            </li>
            <li class="nav-item ml-3">
                <button id="btnDownLoadSample" name="btnDownLoadSample" class="btn btn-outline-warning btn-sm text-nowrap" onclick="btn_Click('DownLoadSample')">下载样例</button>
            </li>

        </ul>
        <div id="ExcelData"></div>

    </div>
                </td>
            </tr>
        </table>
    </div>

    @*-- 功能区 --*@



    @*-- 列表层 --*@
    <div id="divList" class="div_List" style="background-color:#FFF;">
        <div id="divDataLst">
        </div>
        <div id="divPager" class="pager">
        </div>
    </div>
    @*-- 编辑层 --*@
    <div id="divEdit" value="1"></div>
</div>
