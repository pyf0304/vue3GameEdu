    @RenderSection("Styles", required: false)

    <style>
        .layui-nav {
            position: relative;
            padding: 0;
            background-color: #24998d;
            color: #fff;
            border-radius: 2px;
            font-size: 0;
            box-sizing: border-box;
        }
    </style>

</head>
<body style="width:100%;height:100%;">
    <div id="Index_Layout" class="top">
        <div class="top_con">
            <div class="top_title">
                <a id="web_Title" class="web_Title" style="color:white" href="index">游戏化教育平台</a>
                &nbsp;&nbsp;&nbsp;<a id="indexTitle" class="sub_Title" style="color:white"></a>

            </div>


            <div class="top_login">
                <div>
                    <a id="tz_login" href="#" onclick="xadmin.open('登录','../Web/Login?state=1',700,700)">
                        @*<i class="iconfont">&#xe683;</i>*@
                        登录
                    </a>
                    <a id="tz_Register" href="#" onclick="xadmin.open('注册','https://www.sh-tz.com/ExamLib/WebForm/Admin/wfmRegisterStu.aspx?IsShowReturn=false')">注册</a>
                    <a id="userName" href="#" style="display:none;" onclick="btnConsole_Click()"></a>
                    <a id="cancellation" href="#" style="display:none; color:darkorange" onclick="btnCancellation_Click()">注销</a>
                </div>
                <div id="educls_select" style="margin-left:10px;margin-top:10px">
                    <ul class="layui-nav left fast-add" lay-filter="" id="EduCls">
                        <li class="layui-nav-item">
                            <a href="javascript:;">
                                <span id="eduClsName">选择教学班</span>
                            </a>
                            <dl class="layui-nav-child" id="dlEduClsList">
                                <!-- 二级菜单 -->
                            </dl>
                        </li>
                    </ul>
                </div>
               @* <div id="educls_show" class="">
                    <ul class=" layui-nav left fast-add" style="margin-left:20px" lay-filter="" id="EduCls_Show">
                        <li class="layui-nav-item">
                            <span>课程:</span> &nbsp;<span id="strCourseName"></span>
                        </li>
                        <li class="layui-nav-item">
                            &nbsp;&nbsp;&nbsp; <span>&nbsp;  教学班:</span>    <span id="strEduClsName"></span>
                        </li>

                    </ul>
                </div>*@
            </div>
        </div>
    </div>
    @RenderBody()
    <script>
        function Page_Load() {
            require(["../js/Web/Index.js"], function (index) {
                var objPage = new index.Index();
                objPage.Page_Load();
            });
        }

        function btnConsole_Click() {
            require(["../js/Web/Index.js"], function (index) {
                var objPage = new index.Index();
                objPage.btnConsole_Click();
            });
        }
        //注销
        function btnCancellation_Click() {
            require(["../js/Web/Index.js"], function (index) {
                var objPage = new index.Index();
                objPage.btnCancellation_Click();
            });
        }

        //切换教学班
        function EduCls_Click(strkey, strName, strTypeID, strCourseId, strCourseName) {
            require(["../js/Web/Index.js"], function (index) {
                var objPage = new index.Index();
                objPage.EduCls_Click(strkey, strName, strTypeID, strCourseId, strCourseName);
            });
            //RemoveIfame_Click();
        }

        //信息提示
        function layui_Alert(iconKey, strMsg) {

            layer.msg(strMsg, {
                icon: iconKey,
                time: 2000
            });
        }

    </script>

