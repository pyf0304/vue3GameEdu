                <li class="nav-item ml-2"><a asp-page="/TaskMan/TestDate">测试日期插件</a></li>
                <li class="nav-item ml-2"><a asp-page="/TaskMan/TaskTypeCRUD">任务类型维护</a></li>

                <li class="nav-item ml-2"><a asp-page="/TaskMan_UT/TaskTypeCRUD">任务类型-UT</a></li>

                <li class="nav-item ml-2"><a asp-page="/GraduateEdu/SysCommentCRUD">系统评论管理</a></li>
                <li class="nav-item ml-2"><a asp-page="/GraduateEdu/SysCommentTypeCRUD">系统评论类型管理</a></li>
                


            </ul>

        </div>
    </nav>
    <partial name="_CookieConsentPartial" />

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2019 - TaskManage</p>
        </footer>
    </div>

